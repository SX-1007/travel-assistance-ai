# Core Gemini credentials
GEMINI_API_KEY=
GEMINI_IATA_API=
GEMINI_FLIGHTS_HOTELS=
GEMINI_EXTRACTOR_API=
GEMINI_EMBED_API=

# Optional model overrides
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_UTILITY_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2

# Supabase / PostgreSQL
SUPABASE_URL=
SUPABASE_API_KEY=
SUPABASE_POSTGRES_URI=

# Firebase service-account JSON path or raw JSON
FIREBASE_CREDENTIAL_JSON=./FIREBASE_CREDENTIAL_JSON.json

# External providers
MAPBOX_TOKEN=
SERPAPI_FLIGHT=
SERPAPI_HOTEL=
SERPAPI_PLACE=
FREECURRENCY_API=

# Optional legacy vector store
PINECONE_API_KEY=

# Application runtime
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

