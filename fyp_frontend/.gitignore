# Temporary standalone-repository rules.
# The parent ../.gitignore is authoritative for the intended monorepo.

# Environment variables
.env
.env.*
!.env.example

# Dependencies, builds and test output
node_modules/
dist/
dist-ssr/
.vite/
.vitest/
coverage/
*.tsbuildinfo
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local tooling
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
