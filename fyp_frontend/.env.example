# Base URL of the FastAPI backend (fyp_backend). No trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# Value sent as the X-User-ID header on every request.
# The backend trusts this header (see app/api/dependencies.py).
# Single user for v1 — keep this stable so your profile/trips persist.
VITE_USER_ID=test-user-001

# (Optional) Public Mapbox access token — enables the per-day static route map
# in the itinerary view. Get one at https://account.mapbox.com/access-tokens/.
# If unset, the itinerary still shows the route stops + distances as text.
VITE_MAPBOX_TOKEN=
